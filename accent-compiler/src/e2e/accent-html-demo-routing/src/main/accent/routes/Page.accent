package accent.html.demo.routes;

import accent.html.Component;
import accent.html.Html;
import accent.html.spring.Prerender;

@Prerender
public record Page() implements Component {

    @Override
    public Html render() {
        return (
            <main>
                <h1>Welcome to Accent Routing!</h1>
                <p>Go to <a href="/users/Mel">User: Mel</a></p>
            </main>
        );
    }
}
