import java.util.List;

class Main {
    static void main(String[] args) {
        final items = List.of(1, 2);
        for (item in items) {
            println(item);
        } else {
            println("Iteration completed");
        }
        final values = for (item in items) {
            yield item;
        } else {
            yield 3;
        };
        println(values);
    }
}
