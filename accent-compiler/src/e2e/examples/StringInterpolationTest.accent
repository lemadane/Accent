package test;

import java.util.List;
import java.util.ArrayList;

class StringInterpolationTest {
    static void main(String[] args) {
        System.out.println("=== Starting Standalone String Interpolation Test ===");

        // 1. Basic Variable Interpolation
        final name = "Accent Developer";
        final welcome = $"Welcome, {name}!";
        System.out.println("1. Basic Variable: " + welcome);
        static._assertWelcome(welcome, "Welcome, Accent Developer!");

        // 2. Expression & Ternary Interpolation
        final active = true;
        final count = 5;
        final summary = $"Items: {count * 10}, Status: {active then "Active" else "Inactive"}";
        System.out.println("2. Expressions:    " + summary);
        static._assertSummary(summary, "Items: 50, Status: Active");

        // 3. Double Brace Escaping
        final braces = $"{{name: \"{name}\", rating: {count}}}";
        System.out.println("3. Double Braces:  " + braces);
        final quote = Character.toString(34) else "";
        final expectedBraces = "{name: " + quote + "Accent Developer" + quote + ", rating: 5}";
        static._assertBraces(braces, expectedBraces);

        // 4. Multiline Interpolation
        final multiline = $"Line 1: {name}
Line 2: Count is {count}
Line 3: Finished.";
        System.out.println("4. Multiline:\n" + multiline);
        final expectedMultiline = $"Line 1: Accent Developer\nLine 2: Count is 5\nLine 3: Finished.";
        static._assertMultiline(multiline, expectedMultiline);

        // 5. Null Conversion
        final Object nullable? = null;
        final nullStr = $"Value: {nullable?}";
        System.out.println("5. Null Handling:  " + nullStr);
        static._assertNull(nullStr, "Value: null");

        // 6. Evaluation Order (Left-to-Right)
        final List<Integer> order = new ArrayList<Integer>();
        final orderStr = $"{static._recordCall(order, 1)}-{static._recordCall(order, 2)}-{static._recordCall(order, 3)}";
        System.out.println("6. Eval Order:     " + orderStr);
        static._assertOrder(orderStr, "10-20-30");
        static._assertOrderSideEffects(order);

        System.out.println("=== Standalone String Interpolation Test PASSED Successfully! ===");
    }

    private static int _recordCall(List<Integer> list, int id) {
        list.add(id);
        return id * 10;
    }

    private static void _assertWelcome(String actual, String expected) {
        if (not actual.equals(expected)) {
            throw new RuntimeException("Test 1 Failed! Expected '" + expected + "', got '" + actual + "'");
        }
    }

    private static void _assertSummary(String actual, String expected) {
        if (not actual.equals(expected)) {
            throw new RuntimeException("Test 2 Failed! Expected '" + expected + "', got '" + actual + "'");
        }
    }

    private static void _assertBraces(String actual, String expected) {
        if (not actual.equals(expected)) {
            throw new RuntimeException("Test 3 Failed! Expected '" + expected + "', got '" + actual + "'");
        }
    }

    private static void _assertMultiline(String actual, String expected) {
        if (not actual.equals(expected)) {
            throw new RuntimeException("Test 4 Failed! Expected '" + expected + "', got '" + actual + "'");
        }
    }

    private static void _assertNull(String actual, String expected) {
        if (not actual.equals(expected)) {
            throw new RuntimeException("Test 5 Failed! Expected '" + expected + "', got '" + actual + "'");
        }
    }

    private static void _assertOrder(String actual, String expected) {
        if (not actual.equals(expected)) {
            throw new RuntimeException("Test 6 Failed! Expected '" + expected + "', got '" + actual + "'");
        }
    }

    private static void _assertOrderSideEffects(List<Integer> order) {
        if (order.size() != 3 or order.get(0) != 1 or order.get(1) != 2 or order.get(2) != 3) {
            throw new RuntimeException("Test 6 Side Effects Failed! Order list is: " + order);
        }
    }
}
