{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Accent",
  "scopeName": "source.accent",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#triple-strings"
    },
    {
      "include": "#interpolated-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#accent-keywords"
    },
    {
      "include": "#java-keywords"
    },
    {
      "include": "#storage-types"
    },
    {
      "include": "#storage-modifiers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#method-calls"
    },
    {
      "include": "#type-identifiers"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.accent",
          "match": "//.*$"
        },
        {
          "name": "comment.block.accent",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.accent",
          "match": "@[a-zA-Z0-9_.]+"
        }
      ]
    },
    "triple-strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.accent",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "interpolated-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.accent",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.accent",
              "match": "\\\\."
            },
            {
              "include": "#interpolation-expression"
            }
          ]
        }
      ]
    },
    "interpolation-expression": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.accent"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.accent"
        }
      },
      "name": "meta.interpolation.accent",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.accent",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.accent",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "accent-keywords": {
      "patterns": [
        {
          "name": "keyword.control.accent",
          "match": "(?<!\\.)\\b(not|and|or|yield|async|await|generator|emit)\\b"
        }
      ]
    },
    "java-keywords": {
      "patterns": [
        {
          "name": "keyword.control.accent",
          "match": "\\b(if|else|for|while|do|try|catch|finally|throw|return|break|continue|new|instanceof|switch|case|default)\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.accent",
          "match": "\\b(class|interface|record|enum|extension|model|singleton|void|int|long|double|float|boolean|char|byte|short|var|final)\\b"
        }
      ]
    },
    "storage-modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.accent",
          "match": "\\b(static|transient|volatile|synchronized|native|abstract|strictfp|package|import)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.accent",
          "match": "\\b[0-9]+(\\.[0-9]+)?([fFdDlL])?\\b"
        },
        {
          "name": "constant.language.accent",
          "match": "\\b(true|false|null|this|super)\\b"
        }
      ]
    },
    "method-calls": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.accent"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.accent"
            }
          }
        }
      ]
    },
    "type-identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.class.accent",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.accent",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
